# ============================================
# CloudKitchen Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudkitchen?retryWrites=true&w=majority

# --- Supabase ---
# Frontend-safe (exposed to browser via VITE_ prefix in client/.env)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Server-side ONLY — never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Email delivery ---
# 'auto' (default) uses an HTTP provider when its key is set, else SMTP.
# Hosts that block outbound SMTP (Render's free tier blocks ports 25/465/587)
# can only deliver over HTTPS, so set a provider key there.
EMAIL_PROVIDER=auto

# Supabase Edge Function SMTP relay. Render blocks outbound SMTP, but Supabase
# Edge Functions allow port 465, so the relay delivers to Gmail on our behalf.
# Deploy supabase/functions/send-email, then set both of these.
EMAIL_RELAY_URL=https://<project-ref>.supabase.co/functions/v1/send-email
EMAIL_RELAY_SECRET=<long random string, must match RELAY_SECRET on the function>

# Mailjet: 6,000/month (200/day) free, verifies a single sender by email.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Alternatives (only one provider is used at a time)
# BREVO_API_KEY=            # 300/day free, single-sender verification
# RESEND_API_KEY=           # needs a verified DOMAIN to reach anyone but yourself

# --- Email (SMTP fallback, used when no provider key is set) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=CloudKitchen <noreply@cloudkitchen.com>

# Who receives the "new order" alert. Comma-separated.
# Leave blank to alert every user with the ADMIN role instead.
ADMIN_EMAILS=kitchen@yourrestaurant.com

# --- URLs ---
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# --- App ---
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string

# ============================================
# Client-side env (create client/.env):
# ============================================
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co https://mfkoksauazfzwfxcmknd.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_API_URL=http://localhost:5000 (optional, defaults to proxy)
